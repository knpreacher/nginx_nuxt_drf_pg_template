# ---- Домен / TLS (только прод) ----
DOMAIN=example.com
CERTBOT_EMAIL=admin@example.com

# ---- Django ----
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=example.com,localhost,127.0.0.1

# ---- База данных ----
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---- Cookie / JWT ----
JWT_COOKIE_SECURE=1          # для локальной разработки по http поставь 0
JWT_COOKIE_SAMESITE=Lax
JWT_COOKIE_DOMAIN=
JWT_ACCESS_LIFETIME_MIN=15
JWT_REFRESH_LIFETIME_DAYS=7

# ---- CORS / CSRF (за nginx это same-origin, обычно пусто) ----
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=https://example.com

# ---- gunicorn (по желанию) ----
GUNICORN_WORKERS=4
GUNICORN_TIMEOUT=30

# Для локальной разработки по http: DJANGO_DEBUG=1 и JWT_COOKIE_SECURE=0
